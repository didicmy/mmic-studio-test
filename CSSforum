}

.mmic-qeel-group-inseparables {
  --mmic-group-color: #c88a84;
}

.mmic-qeel-group-corbeaux {
  --mmic-group-color: #5e6c7f;
}

.mmic-qeel-group-faucons {
  --mmic-group-color: #b88c4d;
}

.mmic-qeel-group-hirondelles {
  --mmic-group-color: #8e82b5;
}


/* ICÔNES PLUS FINES ET PLUS PETITES */

.mmic-qeel-bird-icon {
  flex: 0 0 15px;

  width: 15px;
  height: 15px;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.mmic-qeel-bird-icon::before {
  width: 14px;
  height: 14px;
}


/* SURVOL PLUS VIVANT MAIS DISCRET */

.mmic-qeel-group:hover .mmic-qeel-bird-icon {
  color: #fbf8f3;

  transform:
    translateX(2px)
    scale(1.02);
}

/* Le bouton complet bouge très légèrement */

.mmic-qeel-group {
  transition:
    padding-left 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    background-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.mmic-qeel-group:hover {
  transform: translateX(2px);

  box-shadow:
    0 3px 7px
    rgba(16, 36, 56, 0.12);
}


/* CHICAGO EN FILIGRANE PLUS DISCRET */

.mmic-qeel-city-mark {
  color: rgba(16, 36, 56, 0.05);
}
/* =========================================================
   OUTILS AU-DESSUS DU QUEEL
   ========================================================= */

.mmic-index-tools {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 7px;

  width: calc(100% - 24px);
  margin: 18px auto;
}

.mmic-index-tool {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  min-height: 30px;
  padding: 0 12px;

  border: 1px solid #d8cbbd;
  border-radius: 6px;

  background: #fbf8f3;
  color: #625951 !important;

  box-shadow: 0 2px 5px rgba(16, 36, 56, 0.05);

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.7px;
  text-decoration: none !important;
  text-transform: uppercase;

  transition:
    color 0.2s ease,
    background-color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.mmic-index-tool-icon {
  display: inline-flex;
  flex: 0 0 18px;
  align-items: center;
  justify-content: center;

  width: 18px;
  height: 18px;

  border-radius: 50%;

  background: #102438;
  color: #d19168;

  font-size: 9px;

  transition:
    color 0.2s ease,
    background-color 0.2s ease,
    transform 0.2s ease;
}

.mmic-index-tool:hover {
  border-color: #b97a56;

  background: #102438;
  color: #fbf8f3 !important;

  box-shadow: 0 4px 9px rgba(16, 36, 56, 0.14);

  transform: translateY(-2px);
}

.mmic-index-tool:hover .mmic-index-tool-icon {
  background: #b97a56;
  color: #fbf8f3;

  transform: rotate(5deg);
}


/* =========================================================
   LÉGENDE DES MESSAGES SOUS LE QUEEL
   ========================================================= */

.mmic-forum-legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8px;

  width: calc(100% - 24px);
  margin: 15px auto 10px;
}

.mmic-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  min-height: 28px;
  padding: 3px 10px 3px 5px;

  border: 1px solid #ddd1c6;
  border-radius: 20px;

  background: #fbf8f3;
  color: #625951;

  box-shadow: 0 2px 5px rgba(16, 36, 56, 0.05);

  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.35px;
  text-transform: uppercase;

  transition:
    border-color 0.2s ease,
    background-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.mmic-legend-icon {
  display: inline-flex;
  flex: 0 0 22px;
  align-items: center;
  justify-content: center;

  width: 22px;
  height: 22px;

  overflow: hidden;

  border: 1px solid #d19168;
  border-radius: 50%;

  background: #102438;
}

.mmic-legend-icon img {
  display: block;

  width: 14px !important;
  height: 14px !important;
  max-width: 14px !important;

  object-fit: contain;
}

.mmic-legend-item:hover {
  border-color: #b97a56;

  background: #102438;
  color: #fbf8f3;

  transform: translateY(-2px);
}

.mmic-legend-new {
  box-shadow: inset 0 0 0 2px rgba(185, 122, 86, 0.22);
}

.mmic-legend-none {
  opacity: 0.82;
}

.mmic-legend-locked {
  background: #596979;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 620px) {
  .mmic-index-tools {
    gap: 5px;
  }

  .mmic-index-tool {
    flex: 1 1 calc(50% - 5px);

    min-width: 135px;
    padding-right: 8px;
    padding-left: 8px;

    font-size: 7px;
  }

  .mmic-forum-legend {
    align-items: stretch;
    flex-direction: column;
  }

  .mmic-legend-item {
    justify-content: flex-start;
    width: 100%;

