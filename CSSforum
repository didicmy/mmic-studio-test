  padding: 0 12px;

  border: 1px solid #d8cbbd !important;
  border-radius: 6px;

  background: #fbf8f3 !important;
  color: #625951 !important;

  box-shadow: 0 2px 5px rgba(16, 36, 56, 0.05);

  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.7px;
  line-height: 1;
  text-decoration: none !important;
  text-transform: uppercase;

