/* =========================================================
   MMIC — TRIGGER WARNING
   ========================================================= */

.mmic-tw {
  display: inline;
  padding: 1px 3px;

  filter: blur(5px);
  opacity: 0.75;

  cursor: help;

  transition:
    filter 0.25s ease,
    opacity 0.25s ease;
}

/* Souris */
.mmic-tw:hover,

/* Clavier / accessibilité */
.mmic-tw:focus {
  filter: blur(0);
  opacity: 1;
  outline: none;
}
