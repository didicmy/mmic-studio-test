/* Le menu généré par Forumactif */

.mmic-viewforum-more-menu {
  display: inline-block !important;

  margin-left: 5px !important;

  font-size: 7px !important;
  line-height: 1 !important;
}


/* Mobile */

@media (max-width: 650px) {
  .mmic-viewforum-navigation {
    align-items: flex-start !important;
    flex-direction: column !important;

    min-height: 0 !important;
  }
}
/* =========================================================
   BOUTONS DE LA PAGE FORUM
   ========================================================= */

/* ---------------------------------------------------------
   NOUVEAU SUJET
   --------------------------------------------------------- */

.mmic-new-topic-button,
.mmic-viewforum-actions a,
.lsuj_newpost a {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 7px !important;

  min-height: 32px !important;
  padding: 0 13px !important;

  border: 1px solid #b97a56 !important;
  border-radius: 6px !important;

  background: #102438 !important;
  color: #fbf8f3 !important;

  box-shadow: 0 3px 8px rgba(16, 36, 56, 0.12) !important;

  font-size: 8px !important;
  font-weight: 700 !important;
  letter-spacing: 0.8px !important;
  line-height: 1 !important;
  text-decoration: none !important;
  text-transform: uppercase !important;

  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease !important;
}

/* On neutralise l’ancien symbole rond ajouté par Forumactif */
.mmic-new-topic-button::before,
.mmic-viewforum-actions a::before,
.lsuj_newpost a::before {
  content: "+" !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: 17px !important;
  height: 17px !important;

  border-radius: 50% !important;

  background: #b97a56 !important;
  color: #fbf8f3 !important;

  font-size: 12px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
}

.mmic-new-topic-button:hover,
.mmic-viewforum-actions a:hover,
.lsuj_newpost a:hover {
  border-color: #102438 !important;

  background: #b97a56 !important;
  color: #fbf8f3 !important;

  box-shadow: 0 5px 12px rgba(16, 36, 56, 0.17) !important;

  transform: translateY(-2px) !important;
}

.mmic-new-topic-button:hover::before,
.mmic-viewforum-actions a:hover::before,
.lsuj_newpost a:hover::before {
  background: #102438 !important;
}


/* ---------------------------------------------------------
   OPTIONS SOUS LA LISTE
   --------------------------------------------------------- */

.mmic-viewforum-options {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-end !important;
  flex-wrap: wrap !important;
  gap: 7px !important;
}

.mmic-viewforum-option,
.mmic-viewforum-option a,
.mmic-viewforum-watch,
.mmic-viewforum-watch a {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6px !important;

  min-height: 28px !important;
  padding: 0 10px !important;

  border: 1px solid #ddd1c6 !important;
  border-radius: 6px !important;

  background: #f7f1e9 !important;
  color: #625951 !important;

  box-shadow: 0 2px 5px rgba(16, 36, 56, 0.04) !important;

  font-size: 7px !important;
  font-weight: 700 !important;
  letter-spacing: 0.6px !important;
  line-height: 1 !important;
  text-decoration: none !important;
  text-transform: uppercase !important;

  box-sizing: border-box !important;

  transition:
    color 0.2s ease,
    background-color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease !important;
}

/* Empêche le texte de "Marquer..." de rester énorme */
.mmic-viewforum-option {
  font-size: 7px !important;
}

.mmic-viewforum-option > span:first-child {
  color: #b97a56 !important;
  font-size: 9px !important;
}

.mmic-viewforum-option:hover,
.mmic-viewforum-option:hover a,
.mmic-viewforum-watch:hover,
.mmic-viewforum-watch:hover a {
  border-color: #b97a56 !important;

  background: #102438 !important;
  color: #fbf8f3 !important;

  box-shadow: 0 4px 9px rgba(16, 36, 56, 0.12) !important;

  transform: translateY(-1px) !important;
}


/* ---------------------------------------------------------
   RETOUR EN HAUT
   --------------------------------------------------------- */

.mmic-topics-backtop {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: 24px !important;
  height: 24px !important;
  padding: 0 !important;

  border: 1px solid #ddd1c6 !important;
  border-radius: 50% !important;

  background: #f7f1e9 !important;
  color: #b97a56 !important;

  font-size: 0 !important;
  text-decoration: none !important;

  transition:
    color 0.2s ease,
    background-color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease !important;
}

.mmic-topics-backtop::before {
  content: "↑" !important;

  font-size: 11px !important;
  line-height: 1 !important;
}

.mmic-topics-backtop:hover {
  border-color: #102438 !important;

  background: #102438 !important;
  color: #fbf8f3 !important;

  transform: translateY(-2px) !important;
}


/* ---------------------------------------------------------
   BLOC SOUS LA LISTE PLUS ÉQUILIBRÉ
   --------------------------------------------------------- */

.mmic-viewforum-links {
  min-height: 42px !important;
  padding: 8px 11px !important;
}

.mmic-viewforum-moderators {
  flex: 1 1 auto !important;
}

.mmic-viewforum-options {
  flex: 0 1 auto !important;
}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 650px) {
  .mmic-viewforum-actions {
    justify-content: stretch !important;
  }

  .mmic-new-topic-button,
  .mmic-viewforum-actions a,
  .lsuj_newpost a {
    width: 100% !important;

    box-sizing: border-box !important;
  }

  .mmic-viewforum-options {
    justify-content: flex-start !important;
  }
}
